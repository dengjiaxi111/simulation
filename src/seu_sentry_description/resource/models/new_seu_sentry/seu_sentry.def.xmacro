<?xml version="1.0"?>
<sdf version="1.11">
  <xmacro_define_block name="new_seu_sentry">
    <link name="chassis">
      <!-- Box approximation (0.43 x 0.42 x 0.18 m), shifted from its collision center to the CAD COM. -->
      <inertial><pose>-0.0036599 0.0024775 -0.12222 0 0 0</pose><mass>12.0</mass><inertia><ixx>0.212431896</ixx><ixy>0.000108847</ixy><ixz>-0.000756356</ixz><iyy>0.221019034</iyy><iyz>0.000511896</iyz><izz>0.361534572</izz></inertia></inertial>
      <visual name="chassis_visual"><geometry><mesh><uri>model://new_seu_sentry/meshes/chejia_link.STL</uri></mesh></geometry></visual>
      <collision name="chassis_main_collision"><pose>0 0 -0.105 0 0 0</pose><geometry><box><size>0.43 0.42 0.18</size></box></geometry></collision>
      <collision name="chassis_upper_collision"><pose>0 0 -0.005 0 0 0</pose><geometry><box><size>0.30 0.30 0.04</size></box></geometry></collision>
    </link>
    <link name="base_footprint"/>
    <joint name="chassis_to_base_footprint" type="fixed"><pose relative_to="chassis">0 0 -0.28585 0 0 0</pose><parent>chassis</parent><child>base_footprint</child></joint>
    <joint name="gimbal_yaw_joint" type="revolute"><pose relative_to="chassis">0 0 0.0165 0 0 1.6032</pose><parent>chassis</parent><child>base_link</child><axis><xyz>0 0 1</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper><effort>100</effort><velocity>20</velocity></limit></axis></joint>
    <link name="base_link">
      <pose relative_to="gimbal_yaw_joint">0 0 0 0 0 0</pose>
      <!--
        Simulation-only yaw decoupling: retain the 0.8 kg gimbal mass and its
        on-axis COM, but make the inertia about the yaw axis negligible.  Equal
        roll / pitch moments keep the inertia tensor positive and well formed.
        The gimbal joint and its position feedback remain unchanged, so the
        existing gimbal-to-chassis velocity transform still uses the same angle.
      -->
      <inertial><pose>0 0 0.125 0 0 0</pose><mass>0.8</mass><inertia><ixx>0.008700000</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.008700000</iyy><iyz>0</iyz><izz>0.000001000</izz></inertia></inertial>
      <visual name="base_link_visual"><geometry><mesh><uri>model://new_seu_sentry/meshes/yuntai_Link.STL</uri></mesh></geometry></visual>
      <collision name="base_link_collision"><pose>0.003 0.0535 0.108 0 0 0</pose><geometry><box><size>0.35 0.19 0.21</size></box></geometry></collision>
    </link>
    <link name="gimbal_yaw"><pose relative_to="base_link">0 0 0 0 0 0</pose></link>
    <joint name="gimbal_yaw_frame_joint" type="fixed"><pose relative_to="base_link">0 0 0 0 0 0</pose><parent>base_link</parent><child>gimbal_yaw</child></joint>

    <joint name="front_left_steer_joint" type="revolute"><pose relative_to="chassis">-0.159 -0.159 -0.156 0 0 2.3562</pose><parent>chassis</parent><child>front_left_steer_link</child><axis><xyz>0 0 1</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper><effort>40</effort><velocity>20</velocity></limit></axis></joint>
    <link name="front_left_steer_link"><pose relative_to="front_left_steer_joint">0 0 0 0 0 0</pose><inertial><pose>-0.000050012 -0.0053218 -0.027486 0 0 0</pose><mass>0.111</mass><inertia><ixx>5.3874e-05</ixx><ixy>9.2212e-09</ixy><ixz>2.0091e-08</ixz><iyy>6.391e-05</iyy><iyz>-4.5093e-07</iyz><izz>7.921e-05</izz></inertia></inertial><visual name="visual"><geometry><mesh><uri>model://new_seu_sentry/meshes/front_left_steer_link.STL</uri></mesh></geometry></visual><collision name="collision"><pose>0 0 -0.027 0 0 0</pose><geometry><cylinder><radius>0.048</radius><length>0.098</length></cylinder></geometry></collision></link>
    <joint name="front_left_wheel_joint" type="revolute"><pose relative_to="front_left_steer_link">0 -0.029 -0.07635 0 0 -1.5708</pose><parent>front_left_steer_link</parent><child>front_left_wheel_link</child><axis><xyz>-1 0 0</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper><effort>40</effort><velocity>100</velocity></limit></axis></joint>
    <link name="front_left_wheel_link"><pose relative_to="front_left_wheel_joint">0 0 0 0 0 0</pose><inertial><pose>-0.019453 0.00012233 -7.8814e-05 0 0 0</pose><mass>0.166</mass><inertia><ixx>0.00017243</ixx><ixy>-2.7457e-08</ixy><ixz>-7.2914e-08</ixz><iyy>9.6065e-05</iyy><iyz>-4.0029e-07</iyz><izz>9.5188e-05</izz></inertia></inertial><visual name="visual"><geometry><mesh><uri>model://new_seu_sentry/meshes/front_left_wheel_link.STL</uri></mesh></geometry></visual><collision name="collision"><pose>-0.019453 0.00012233 -7.8814e-05 0 1.5707963 0</pose><geometry><cylinder><radius>0.0535</radius><length>0.05</length></cylinder></geometry><surface><friction><ode><mu>0.2</mu><mu2>0.2</mu2></ode></friction></surface></collision></link>

    <joint name="front_right_steer_joint" type="revolute"><pose relative_to="chassis">0.159 -0.159 -0.156 0 0 -2.3562</pose><parent>chassis</parent><child>front_right_steer_link</child><axis><xyz>0 0 1</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper><effort>40</effort><velocity>20</velocity></limit></axis></joint>
    <link name="front_right_steer_link"><pose relative_to="front_right_steer_joint">0 0 0 0 0 0</pose><inertial><pose>-0.00032133 -0.0097971 -0.024737 0 0 0</pose><mass>0.111</mass><inertia><ixx>5.4052e-05</ixx><ixy>1.0402e-08</ixy><ixz>-4.1541e-15</ixz><iyy>6.203e-05</iyy><iyz>-4.5086e-07</iyz><izz>7.9202e-05</izz></inertia></inertial><visual name="visual"><geometry><mesh><uri>model://new_seu_sentry/meshes/front_right_steer_link.STL</uri></mesh></geometry></visual><collision name="collision"><pose>0 0 -0.025 0 0 0</pose><geometry><cylinder><radius>0.048</radius><length>0.098</length></cylinder></geometry></collision></link>
    <joint name="front_right_wheel_joint" type="revolute"><pose relative_to="front_right_steer_link">0 -0.029 -0.07635 0 0 -1.5708</pose><parent>front_right_steer_link</parent><child>front_right_wheel_link</child><axis><xyz>-1 0 0</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper><effort>40</effort><velocity>100</velocity></limit></axis></joint>
    <link name="front_right_wheel_link"><pose relative_to="front_right_wheel_joint">0 0 0 0 0 0</pose><inertial><pose>-0.019538 0.00012734 -8.2044e-05 0 0 0</pose><mass>0.166</mass><inertia><ixx>0.00016744</ixx><ixy>-2.7457e-08</ixy><ixz>-7.2914e-08</ixz><iyy>9.3542e-05</iyy><iyz>-4.0029e-07</iyz><izz>9.2665e-05</izz></inertia></inertial><visual name="visual"><geometry><mesh><uri>model://new_seu_sentry/meshes/front_right_wheel_link.STL</uri></mesh></geometry></visual><collision name="collision"><pose>-0.019538 0.00012734 -8.2044e-05 0 1.5707963 0</pose><geometry><cylinder><radius>0.0535</radius><length>0.05</length></cylinder></geometry><surface><friction><ode><mu>0.2</mu><mu2>0.2</mu2></ode></friction></surface></collision></link>

    <joint name="rear_right_steer_joint" type="revolute"><pose relative_to="chassis">0.159 0.159 -0.16735 0 0 -0.7854</pose><parent>chassis</parent><child>rear_right_steer_link</child><axis><xyz>0 0 1</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper><effort>40</effort><velocity>20</velocity></limit></axis></joint>
    <link name="rear_right_steer_link"><pose relative_to="rear_right_steer_joint">0 0 0 0 0 0</pose><inertial><pose>-0.00019113 -0.017235 -0.038745 0 0 0</pose><mass>0.18454</mass><inertia><ixx>6.751e-05</ixx><ixy>3.7868e-08</ixy><ixz>4.3177e-08</ixz><iyy>7.9121e-05</iyy><iyz>-3.7795e-07</iyz><izz>9.1743e-05</izz></inertia></inertial><visual name="visual"><geometry><mesh><uri>model://new_seu_sentry/meshes/rear_right_steer_link.STL</uri></mesh></geometry></visual><collision name="collision"><pose>0 0 -0.039 0 0 0</pose><geometry><cylinder><radius>0.048</radius><length>0.098</length></cylinder></geometry></collision></link>
    <joint name="rear_right_wheel_joint" type="revolute"><pose relative_to="rear_right_steer_link">0 -0.029 -0.065 0 0 -1.5707963</pose><parent>rear_right_steer_link</parent><child>rear_right_wheel_link</child><axis><xyz>-1 0 0</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper><effort>40</effort><velocity>100</velocity></limit></axis></joint>
    <link name="rear_right_wheel_link"><pose relative_to="rear_right_wheel_joint">0 0 0 0 0 0</pose><inertial><pose>-0.019684 0.00013642 -8.7894e-05 0 0 0</pose><mass>0.16615</mass><inertia><ixx>0.0001487</ixx><ixy>-2.7457e-08</ixy><ixz>-7.2914e-08</ixz><iyy>8.4163e-05</iyy><iyz>-4.0029e-07</iyz><izz>8.3286e-05</izz></inertia></inertial><visual name="visual"><geometry><mesh><uri>model://new_seu_sentry/meshes/rear_right_wheel_link.STL</uri></mesh></geometry></visual><collision name="collision"><pose>-0.019684 0.00013642 -8.7894e-05 0 1.5707963 0</pose><geometry><cylinder><radius>0.0535</radius><length>0.05</length></cylinder></geometry><surface><friction><ode><mu>0.2</mu><mu2>0.2</mu2></ode></friction></surface></collision></link>

    <joint name="rear_left_steer_joint" type="revolute"><pose relative_to="chassis">-0.159 0.159 -0.16735 0 0 0.7853982</pose><parent>chassis</parent><child>rear_left_steer_link</child><axis><xyz>0 0 1</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper><effort>40</effort><velocity>20</velocity></limit></axis></joint>
    <!-- Source URDF inertia was all zero; use the measured front-left steering inertia as a safe non-singular approximation. -->
    <link name="rear_left_steer_link"><pose relative_to="rear_left_steer_joint">0 0 0 0 0 0</pose><inertial><pose>0 0 -0.027 0 0 0</pose><mass>0.111</mass><inertia><ixx>5.3874e-05</ixx><ixy>0</ixy><ixz>0</ixz><iyy>6.391e-05</iyy><iyz>0</iyz><izz>7.921e-05</izz></inertia></inertial><visual name="visual"><geometry><mesh><uri>model://new_seu_sentry/meshes/rear_left_steer_link.STL</uri></mesh></geometry></visual><collision name="collision"><pose>0 0 -0.027 0 0 0</pose><geometry><cylinder><radius>0.048</radius><length>0.098</length></cylinder></geometry></collision></link>
    <joint name="rear_left_wheel_joint" type="revolute"><pose relative_to="rear_left_steer_link">0 -0.029 -0.065 1.5707963 0 -1.5707963</pose><parent>rear_left_steer_link</parent><child>rear_left_wheel_link</child><axis><xyz>-1 0 0</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper><effort>40</effort><velocity>100</velocity></limit></axis></joint>
    <link name="rear_left_wheel_link"><pose relative_to="rear_left_wheel_joint">0 0 0 0 0 0</pose><inertial><pose>-0.019684 -8.7894e-05 -0.00013642 0 0 0</pose><mass>0.16615</mass><inertia><ixx>0.0001487</ixx><ixy>-7.2914e-08</ixy><ixz>2.7457e-08</ixz><iyy>8.3286e-05</iyy><iyz>4.0029e-07</iyz><izz>8.4163e-05</izz></inertia></inertial><visual name="visual"><geometry><mesh><uri>model://new_seu_sentry/meshes/rear_left_wheel_link.STL</uri></mesh></geometry></visual><collision name="collision"><pose>-0.019684 -8.7894e-05 -0.00013642 0 1.5707963 0</pose><geometry><cylinder><radius>0.0535</radius><length>0.05</length></cylinder></geometry><surface><friction><ode><mu>0.2</mu><mu2>0.2</mu2></ode></friction></surface></collision></link>
  </xmacro_define_block>
</sdf>
