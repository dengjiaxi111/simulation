        <pose>0.003 0.0535 0.108 0 0 0</pose>
        <geometry><box><size>0.35 0.19 0.21</size></box></geometry>
      </collision>
    </link>

    <!-- Named yaw frame, matching PB2025's gimbal_yaw sensor parent. -->
    <link name="gimbal_yaw">
      <pose relative_to="base_link">0 0 0 0 0 0</pose>
    </link>
    <joint name="gimbal_yaw_frame_joint" type="fixed">
      <pose relative_to="base_link">0 0 0 0 0 0</pose>
      <parent>base_link</parent><child>gimbal_yaw</child>
    </joint>

