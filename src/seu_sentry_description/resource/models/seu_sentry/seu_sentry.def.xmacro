<?xml version="1.0"?>
<sdf version="1.11">
  <xmacro_define_block name="seu_sentry">
    <link name="chassis">
      <inertial>
        <pose>-0.00000154 0.01204562 -0.11077446 0 0 0</pose>
        <mass>2.7588</mass>
        <inertia>
          <ixx>0.06445505</ixx><ixy>0.00005266</ixy><ixz>-0.00000438</ixz>
          <iyy>0.05836049</iyy><iyz>-0.00069991</iyz><izz>0.10886368</izz>
        </inertia>
      </inertial>
      <visual name="chassis_visual">
        <geometry><mesh><uri>model://seu_sentry/meshes/chassis.STL</uri></mesh></geometry>
      </visual>
      <collision name="chassis_main_collision">
        <pose>0 0 -0.105 0 0 0</pose>
        <geometry><box><size>0.43 0.42 0.18</size></box></geometry>
      </collision>
      <collision name="chassis_upper_collision">
        <pose>0 0 -0.005 0 0 0</pose>
        <geometry><box><size>0.30 0.30 0.04</size></box></geometry>
      </collision>
    </link>

    <link name="base_footprint"/>
    <joint name="chassis_to_base_footprint" type="fixed">
      <pose relative_to="chassis">0 0 -0.2163 0 0 0</pose>
      <parent>chassis</parent><child>base_footprint</child>
    </joint>

    <joint name="gimbal_yaw_joint" type="revolute">
      <pose relative_to="chassis">0 0 0.0165 0 0 1.6032</pose>
      <parent>chassis</parent><child>base_link</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper><effort>100</effort><velocity>20</velocity></limit></axis>
    </joint>
    <link name="base_link">
      <pose relative_to="gimbal_yaw_joint">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0.003 0.0535 0.108 0 0 0</pose>
        <mass>1.548</mass>
        <inertia>
          <ixx>0.01034580</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.02149140</iyy><iyz>0</iyz><izz>0.02045940</izz>
        </inertia>
      </inertial>
      <visual name="base_link_visual">
        <geometry><mesh><uri>model://seu_sentry/meshes/base_link.STL</uri></mesh></geometry>
