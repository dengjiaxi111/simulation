<?xml version="1.0"?>
<robot name="sentry">

  <material name="gray"><color rgba="0.6 0.6 0.6 1.0"/></material>
  <material name="black"><color rgba="0 0 0 1.0"/></material>
  <material name="red"><color rgba="0.8 0.2 0.2 1.0"/></material>

  <link name="base_link">
    <inertial>
      <mass value="12.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.2933" ixy="0" ixz="0" iyy="0.2933" iyz="0" izz="0.4333"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><box size="0.5 0.5 0.2"/></geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><box size="0.5 0.5 0.2"/></geometry>
    </collision>
  </link>

  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.10" radius="0.08"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.10" radius="0.08"/>
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>30</mu>
            <mu2>15</mu2>
            <slip1>0.001</slip1>
            <slip2>0.001</slip2>
          </ode>
        </friction>
      </surface>
    </collision>
    <inertial>
      <mass value="1.2"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="0.003733"
        ixy="0"
        ixz="0"
        iyy="0.003733"
        iyz="0"
        izz="0.000768"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0.12 0.17 -0.08" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="120.0" velocity="30.0"/>
    <dynamics damping="0.05" friction="0.05"/>
    <physics>
      <ode>
        <stopCfm>0.001</stopCfm>
        <stopErp>0.8</stopErp>
      </ode>
    </physics>
  </joint>

  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.10" radius="0.08"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.10" radius="0.08"/>
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>30</mu>
            <mu2>15</mu2>
            <slip1>0.001</slip1>
            <slip2>0.001</slip2>
          </ode>
        </friction>
      </surface>
    </collision>

    <inertial>
      <mass value="1.2"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="0.003733"
        ixy="0"
        ixz="0"
        iyy="0.003733"
        iyz="0"
        izz="0.000768"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0.12 -0.17 -0.08" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="120.0" velocity="30.0"/>
    <dynamics damping="0.05" friction="0.05"/>
    <physics>
      <ode>
        <stopCfm>0.001</stopCfm>
        <stopErp>0.8</stopErp>
      </ode>
    </physics>
  </joint>

  <link name="caster">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.07" length="0.10"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.06" length="0.12"/></geometry>
      <surface>
        <friction>
          <ode>
            <mu>5</mu>
            <mu2>2</mu2>
            <slip1>0.002</slip1>
            <slip2>0.002</slip2>
          </ode>
        </friction>
      </surface>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.000821" ixy="0" ixz="0" iyy="0.0004105" iyz="0" izz="0.0004105"/>
    </inertial>
  </link>

  <joint name="caster_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="caster"/>
    <origin xyz="-0.18 0.0 -0.11" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder length="0.04" radius="0.03"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.20 0.0 0.15" rpy="0 0.349 0"/>
  </joint>

  <link name="imu_link">
    <visual>
      <geometry><box size="0.02 0.02 0.02"/></geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.011 0.02329 0.00588" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <ignition_frame_id>lidar_link</ignition_frame_id>
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <visualize>true</visualize>
      <topic>/lidar</topic>
      <namespace></namespace>
      <ray>
        <scan>
          <horizontal>
            <samples>1500</samples>
            <resolution>1.0</resolution>
            <min_angle>0</min_angle>
            <max_angle>6.2831852</max_angle>
          </horizontal>
          <vertical>
            <samples>128</samples>
            <min_angle>-0.12217304764</min_angle>
            <max_angle>0.90757121104</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.1</min>
          <max>50.0</max>
        </range>
      </ray>
      <noise>
        <type>gaussian</type>
        <mean>0.0</mean>
        <stddev>0.005</stddev>
      </noise>
    </sensor>
  </gazebo>
  
  <gazebo reference="caster">
    <mu1 value="5"/>
    <mu2 value="2"/>
  </gazebo>
  
  <gazebo reference="left_wheel">
    <mu1 value="1.5"/>
    <mu2 value="1.5"/>
  </gazebo>
  
  <gazebo reference="right_wheel">
    <mu1 value="1.5"/>
    <mu2 value="1.5"/>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <ignition_frame_id>imu_link</ignition_frame_id>
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/livox/imu</topic>
      <namespace>my_diffbot</namespace>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise>
          </x>
          <y>
            <noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise>
          </y>
          <z>
            <noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise>
          </x>
          <y>
            <noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise>
          </y>
          <z>
            <noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
  
    <joint name="left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-80</param>
        <param name="max">80</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    
    <joint name="right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-80</param>
        <param name="max">80</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="caster_wheel_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>__VELOCITY_CONTROLLER_CONFIG__</parameters>
    </plugin>
  </gazebo>

</robot>

