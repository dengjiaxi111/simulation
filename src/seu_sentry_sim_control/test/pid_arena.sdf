<?xml version="1.0"?>
<sdf version="1.9"><world name="default">
<physics type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
<plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
<plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
<plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
<plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
<plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
<light name="sun" type="directional"><pose>0 0 30 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><direction>-0.5 0.1 -0.9</direction></light>
<model name="floor"><static>true</static><pose>0 0 0.358656 0 0 0</pose><link name="floor">
<collision name="floor"><geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry></collision>
<visual name="floor"><geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry><material><ambient>0.5 0.5 0.5 1</ambient></material></visual>
</link></model>
</world></sdf>
