<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>seu_sentry_sim_control</name>
  <version>0.1.0</version>
  <description>Standalone four-module swerve kinematics controller for the SEU sentry simulation.</description>
  <maintainer email="dengjiaxi@todo.todo">dengjiaxi</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>gz_sim_vendor</build_depend>
  <build_depend>gz_plugin_vendor</build_depend>
  <build_depend>gz_transport_vendor</build_depend>
  <depend>geometry_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>gz_sim_vendor</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
